    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}

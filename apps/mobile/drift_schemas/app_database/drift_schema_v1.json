  "fixed_sql": [
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" TEXT NOT NULL, \"request_id\" TEXT NOT NULL, \"day_year\" INTEGER NOT NULL, \"day_month\" INTEGER NOT NULL, \"day_day\" INTEGER NOT NULL, \"day_time_zone_id\" TEXT NOT NULL, \"day_cutoff_micros\" INTEGER NOT NULL, \"day_policy_version\" INTEGER NOT NULL, \"role\" TEXT NOT NULL, \"message_text\" TEXT NULL, \"photo_asset_id\" TEXT NULL, \"created_at_utc\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"request_id\", \"role\"), CHECK (length(trim(\"id\")) > 0), CHECK (length(trim(\"request_id\")) > 0), CHECK (length(trim(\"day_time_zone_id\")) > 0), CHECK (\"day_year\" BETWEEN 1 AND 9999), CHECK (\"day_month\" BETWEEN 1 AND 12), CHECK (\"day_day\" BETWEEN 1 AND CASE WHEN \"day_month\" IN (4, 6, 9, 11) THEN 30 WHEN \"day_month\" = 2 THEN CASE WHEN (\"day_year\" % 400 = 0 OR (\"day_year\" % 4 = 0 AND \"day_year\" % 100 != 0)) THEN 29 ELSE 28 END ELSE 31 END), CHECK (\"day_cutoff_micros\" = 0), CHECK (\"day_policy_version\" = 1), CHECK (\"role\" IN ('user', 'assistant')), CHECK (\"status\" IN ('pending', 'sent', 'failed')), CHECK (\"message_text\" IS NULL OR length(trim(\"message_text\")) > 0), CHECK (\"photo_asset_id\" IS NULL OR length(trim(\"photo_asset_id\")) > 0), CHECK (\"message_text\" IS NOT NULL OR \"photo_asset_id\" IS NOT NULL));"
        }
      ]
    },

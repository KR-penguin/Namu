{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://namu.app/contracts/diary-generation/v1.schema.json",
  "title": "Namu diary generation output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mood",
    "oneLineSummary",
    "theme",
    "blocks",
    "memoryCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mood": {
      "type": "string",
      "minLength": 1
    },
    "oneLineSummary": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "enum": ["light", "dark"]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/textBlock"},
          {"$ref": "#/$defs/photoBlock"}
        ]
      }
    },
    "memoryCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memoryCandidate"
      }
    }
  },
  "$defs": {
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "photoBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "photoAssetId"],
      "properties": {
        "type": {
          "const": "photo"
        },
        "photoAssetId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memoryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "sourceMessageIds"],
      "properties": {
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "sourceMessageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "photoAssetId and sourceMessageIds are also checked against the IDs supplied to the generation request."
}
